#!/bin/sh
# live-build configuration for Capyloon x86_64 live ISO.
# Base: Debian 12 bookworm, amd64, hybrid BIOS+UEFI GRUB boot.
set -e

lb config noauto \
    --distribution bookworm \
    --architecture amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --mirror-bootstrap http://deb.debian.org/debian \
    --mirror-chroot http://deb.debian.org/debian \
    --mirror-chroot-security http://deb.debian.org/debian-security \
    --mirror-binary http://deb.debian.org/debian \
    --mirror-binary-security http://deb.debian.org/debian-security \
    --mirror-debian-installer http://deb.debian.org/debian \
    --binary-images iso-hybrid \
    --bootloaders "grub-pc grub-efi" \
    --iso-volume "CAPYLOON_X86_64" \
    --iso-application "Capyloon OS x86_64" \
    --iso-publisher "Capyloon x86_64 Project;https://github.com/luogen-vip/capyloon-x86_64" \
    --bootappend-live "boot=live components quiet splash" \
    --username capyloon \
    --hostname capyloon \
    --debian-installer none \
    --firmware-binary true \
    --firmware-chroot true \
    --backports false \
    --security true \
    --updates false \
    --cache-packages true \
    --debian-installer-distribution none \
    "${@}"
