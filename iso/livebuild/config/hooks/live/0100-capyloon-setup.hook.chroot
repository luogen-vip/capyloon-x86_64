#!/bin/bash
# Capyloon x86_64 live image post-setup (runs inside chroot as root).
set -e

echo "==== [hook] locales ===="
if [ -f /etc/locale.gen ]; then
    sed -i 's/^# *zh_CN.UTF-8 UTF-8/zh_CN.UTF-8 UTF-8/' /etc/locale.gen
    sed -i 's/^# *zh_SG.UTF-8 UTF-8/zh_SG.UTF-8 UTF-8/' /etc/locale.gen
    sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
    locale-gen 2>/dev/null || true
fi

echo "==== [hook] timezone (Asia/Shanghai) ===="
ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime
echo "Asia/Shanghai" > /etc/timezone

echo "==== [hook] user setup ===="
# Create the user in the rootfs so it exists in BOTH the live session and the
# installed system (live-boot skips creation when the user already exists;
# the installed system never runs live-boot at all). uid 1000 matches what
# capyloon.service expects (User=1000).
if ! id capyloon >/dev/null 2>&1; then
    useradd -m -u 1000 -s /bin/bash -c "Capyloon User" capyloon
fi
usermod -aG audio,video,input,render,netdev,bluetooth,plugdev,disk,adm,users capyloon || true
echo 'capyloon:capyloon' | chpasswd
echo 'root:root' | chpasswd

echo "==== [hook] hostname ===="
echo capyloon > /etc/hostname
sed -i 's/127.0.1.1.*/127.0.1.1\tcapyloon/' /etc/hosts || true
grep -q capyloon /etc/hosts || echo "127.0.1.1  capyloon" >> /etc/hosts

echo "==== [hook] plymouth theme ===="
# The official capyloon theme deb is installed from config/packages.chroot.
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme capyloon 2>/dev/null || true
fi

echo "==== [hook] enable services ===="
# systemctl enable may silently fail inside the lb chroot; fall back to
# creating the symlinks directly so both live and installed systems boot
# with these services active.
enable_unit() {
    local unit="$1"
    systemctl enable "$unit" 2>/dev/null || true
    local src="/lib/systemd/system/$unit"
    local dst="/etc/systemd/system/multi-user.target.wants/$unit"
    if [ -f "$src" ] && [ ! -e "$dst" ]; then
        mkdir -p "$(dirname "$dst")"
        ln -sf "$src" "$dst"
        echo "  linked $unit"
    fi
}
enable_unit NetworkManager.service
enable_unit bluetooth.service
enable_unit capyloon.service
enable_unit b2ghald.service
enable_unit haveged.service
enable_unit systemd-resolved.service

echo "==== [hook] gecko desktop prefs (extra safety) ===="
# Appended on first boot by /opt/capyloon/start.sh via user.js; here we make
# sure a fallback config exists for the api-daemon systemd environment.
mkdir -p /etc/capyloon
echo "CAPYLOON_X86_64=1" > /etc/capyloon/build-info

echo "==== [hook] done ===="
exit 0
